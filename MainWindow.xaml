<Window x:Class="WpfVisualValidationDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Component Lab — UI Control Gallery" Width="1200" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#10283B">
      <StackPanel Margin="22,26">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,42"><Border Background="#00A9CE" Width="36" Height="36" CornerRadius="7" Margin="0,0,11,0"><TextBlock Text="I" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="INSURACARE" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="COMPONENT LAB" Foreground="#AFC7D8" FontSize="10"/></StackPanel></StackPanel>
        <TextBlock Text="WPF COMPONENT LIBRARY" Foreground="#8FAABD" FontWeight="Bold" FontSize="10" Margin="10,0,0,10"/>
        <Border Background="#1E4A67" CornerRadius="5" Padding="12,10"><TextBlock Text="▦   Interactive controls" Foreground="White" FontWeight="SemiBold"/></Border>
        <TextBlock Text="Button states" Foreground="#B7CDD9" Margin="12,18,0,8"/><TextBlock Text="Selection &amp; inputs" Foreground="#B7CDD9" Margin="12,0,0,8"/><TextBlock Text="Workflow scenarios" Foreground="#B7CDD9" Margin="12,0,0,8"/>
      </StackPanel>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="34,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Interactive UI Control Gallery" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Hover, press, focus, disabled and clicked states" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,30,34,40">
        <TextBlock Text="Control behavior reference" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Interact with each control to expose the states a visual-validation platform should capture." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
        <Border x:Name="FeedbackPanel" Background="#E8F4F8" BorderBrush="#B8DDE8" BorderThickness="1" CornerRadius="7" Padding="16,12" Margin="0,0,0,24"><TextBlock x:Name="FeedbackText" Text="Tip: hover, press and use Tab to verify mouse and keyboard focus states." Foreground="#005B75" FontWeight="SemiBold"/></Border>
        <TextBlock Text="BUTTON" FontWeight="Bold" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9"/>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,24"><StackPanel><TextBlock Text="Action variants" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Every button supports hover, pressed, keyboard focus and click feedback." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,20"/><WrapPanel>
          <StackPanel Margin="0,0,26,0"><TextBlock Text="Primary" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><Button Style="{StaticResource PrimaryButton}" Content="Save changes" Tag="Changes saved" Click="ActionButton_Click"/></StackPanel>
          <StackPanel Margin="0,0,26,0"><TextBlock Text="Secondary" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><Button Content="Cancel" Tag="Changes cancelled" Click="ActionButton_Click"/></StackPanel>
          <StackPanel Margin="0,0,26,0"><TextBlock Text="Disabled" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><Button Content="Unavailable" IsEnabled="False"/></StackPanel>
          <StackPanel><TextBlock Text="Critical" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><Button Style="{StaticResource CriticalButton}" Content="Escalate" Tag="Escalation created" Click="ActionButton_Click"/></StackPanel>
        </WrapPanel></StackPanel></Border>
        <TextBlock Text="SELECTION AND INPUT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9"/>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,22,0"><TextBlock Text="ComboBox variants" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Open a list and select a value." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Default" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="PriorityPicker" SelectedIndex="0" SelectionChanged="PriorityPicker_SelectionChanged"><ComboBoxItem Content="Select priority"/><ComboBoxItem Content="Routine"/><ComboBoxItem Content="Urgent"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Disabled" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ComboBox IsEnabled="False" SelectedIndex="0"><ComboBoxItem Content="Not available"/></ComboBox></StackPanel></Grid></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Text input and choice" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Focus, edit and toggle these controls." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,16"/><TextBox x:Name="ClinicalNote" Text="Routine observation" TextChanged="ClinicalNote_TextChanged"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,9" Margin="0,0,6,0"><StackPanel><TextBlock Text="Review confirmation" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><CheckBox x:Name="ConfirmationCheck" Content="I confirm this review" Checked="ConfirmationCheck_Changed" Unchecked="ConfirmationCheck_Changed"/></StackPanel></Border><Border Grid.Column="1" Background="#F9FAFB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,9" Margin="6,0,0,0"><StackPanel><TextBlock Text="Notifications" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ToggleButton x:Name="AlertToggle" Content="Alert notifications" Checked="AlertToggle_Changed" Unchecked="AlertToggle_Changed"/></StackPanel></Border></Grid></StackPanel>
        </Grid></Border>
        <TextBlock Text="WORKFLOW SCENARIO" FontWeight="Bold" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9"/>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Patient action" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ScenarioText" Text="Stable patient — routine review ready" Foreground="#138A5B" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="ScenarioPicker" Width="190" SelectedIndex="0" SelectionChanged="ScenarioPicker_SelectionChanged" Margin="0,0,10,0"><ComboBoxItem Content="Stable patient"/><ComboBoxItem Content="Needs attention"/><ComboBoxItem Content="Data unavailable"/></ComboBox><Button x:Name="ScenarioAction" Style="{StaticResource PrimaryButton}" Content="Review patient" Click="ScenarioAction_Click"/></StackPanel></Grid></Border>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
